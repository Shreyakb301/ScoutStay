# Copy to .env.local and fill in. All keys are read server-side only and are
# never exposed to the browser. Missing keys degrade gracefully (manual entry,
# straight-line airport estimates, deterministic brief).

# --- Listing scraping -------------------------------------------------------
# Firecrawl is primary. Create a key at https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- Google Maps (real airport driving times) -------------------------------
# Enable the Routes API for this key. Used server-side via /api/airport-route.
GOOGLE_MAPS_API_KEY=

# --- OpenAI (AI decision brief) ---------------------------------------------
# Used server-side via /api/ai-brief.
OPENAI_API_KEY=
